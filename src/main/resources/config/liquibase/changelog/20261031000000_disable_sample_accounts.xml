<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- Only the explicitly selected Render context applies this to the new hosted database. -->
    <changeSet id="20261031000000-1" author="codex" context="@render">
        <update tableName="jhi_user">
            <column name="activated" valueBoolean="false"/>
            <where>login IN ('admin', 'user') AND created_by = 'system'</where>
        </update>
    </changeSet>
</databaseChangeLog>

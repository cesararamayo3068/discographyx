{
  "annotations": {},
  "applications": ["*"],
  "documentation": "Musical releases associated with bands.",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "musicBrainzId",
      "fieldType": "UUID",
      "fieldValidateRules": ["required", "unique"]
    },
    {
      "fieldName": "title",
      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength"],
      "fieldValidateRulesMaxlength": "200",
      "fieldValidateRulesMinlength": "1"
    },
    {
      "fieldName": "releaseYear",
      "fieldType": "Integer",
      "fieldValidateRules": ["min", "max"],
      "fieldValidateRulesMax": "2100",
      "fieldValidateRulesMin": "1800"
    },
    {
      "fieldName": "releaseType",
      "fieldType": "ReleaseType",
      "fieldTypeDocumentation": "Musical release categories.",
      "fieldValues": "STUDIO,LIVE,EP,DEMO,COMPILATION,SINGLE"
    },
    {
      "fieldName": "coverUrl",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "500"
    }
  ],
  "name": "Album",
  "pagination": "pagination",
  "relationships": [
    {
      "otherEntityField": "name",
      "otherEntityName": "band",
      "otherEntityRelationshipName": "albums",
      "relationshipName": "band",
      "relationshipSide": "right",
      "relationshipType": "many-to-one",
      "relationshipValidateRules": "required"
    }
  ],
  "service": "serviceClass"
}
